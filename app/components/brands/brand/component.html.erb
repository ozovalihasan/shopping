<%= link_to products_path(brands_ids: [@brand.id]), class: "w-full sm:w-1/2 md:w-1/3 lg:w-1/5 min-w-[20%]", data: {"turbo-action": "advance", "turbo-frame": main_parts_target} do %>
  <div class="bg-first-100 hover:bg-first-300 border border-solid border-red-200 m-4 rounded-md">
    <div id="<%= dom_id @brand %>" class="rounded-md">
      <%= image_tag @brand.image, class: "rounded-t-md rounded-b-lg aspect-square", loading: "lazy" %>
      <p class=" p-2 rounded-b-md w-full">
        <%= @brand.name %>
      </p>
    </div>
  </div>
<% end %>
