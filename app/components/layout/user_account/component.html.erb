<div id="user-account" class="text-lg whitespace-nowrap">
  <% if @current_user %>
    <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "font-bold btn-second p-2", data: {turbo: false} %>
  <% else %>
    <%= link_to "Sign in", new_customer_session_path, class: "font-bold btn-second p-2", data: {"turbo-frame": main_parts_target} %>
  <% end %>
</div>