<%= @form.select :category_id,
                options_for_select(
                  [["All Categories", "", { class: "cursor-pointer hover:bg-fourth-100 checked:bg-fourth-200 rounded my-0.5" }]].concat(
                    @main_categories.map {|main_category|
                      [
                        [main_category.name, main_category.id, { class: "pl-2 cursor-pointer hover:bg-fourth-100 checked:bg-fourth-200 rounded my-0.5" } ]
                      ].concat( main_category.categories.map {|category| [category.name, category.id, { class: "ml-4 pl-2 cursor-pointer hover:bg-fourth-100 checked:bg-fourth-200 rounded my-0.5 text-sm" }]}   )
                    }.flatten(1)
                  ),
                  @category_id || ""
                ),
                {include_blank: false},
                {
                  size: [1 + @main_categories.size + @main_categories.sum {|main_category| main_category.categories.size}, 10].min,
                  class: "outline-none w-full px-2 ",
                  data: {
                    action:"input->left-search-form#search"
                  }
  
                }
%>