<%= render component("frame/body") do %>
  <%= render component("shared/carousel") do %>
    <%= render components("categories/category", @main_categories) %>
  <% end %>

  <% if @best_campaign %>
    <%= render component("shared/card", title: "Best Deals") do %>
      <%= render component("shared/carousel", classes: "items-center") do %>
        <div class="flex shrink-0 sm:w-2/3 md:w-1/2 lg:w-1/3 mr-2">
          <%= image_tag @best_campaign.image, class: "aspect-square  rounded-md" %>
        </div>
        
        <div class="h-full">
          <div class="flex  gap-x-4 gap-y-8 ">
            <%= render components("products/product", @products_of_best_deal) %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= render component("shared/card", title: "Brands") do %>
    <%= render component("shared/carousel") do %>
      <%= render components("brands/brand", @brands) %>
    <% end %>
  <% end %>
  

  
  <div class="flex flex-wrap w-full justify-evenly items-stretch gap-x-4 gap-y-8">
    <%= render components("products/product", @products) %>
  </div>

<% end %>
