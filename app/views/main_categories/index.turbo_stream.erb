<%= turbo_stream.replace "user-account" do %>
  <%= render component("layout/user_account", current_user: current_user) %>
<% end %>

<%= turbo_stream.replace main_parts_target do %>
  <%= render component(
    "shared/main_page", 
    main_categories: @main_categories, 
    products: @products, 
    products_of_best_deal: @products_of_best_deal,
    best_campaign: @best_campaign,
    brands: @brands
  ) 
  %>
<% end %>

<%= turbo_stream.replace "cart" do %>
  <%= render component("carts/navbar", cart: @cart) %>
<% end %>