<%= render component("frame/body") do %>

  <div>
    
    <div class="flex">
      <div class="w-1/2 aspect-square rounded-md p-4">
        <%= render component("products/show/image_tabs", images: @product.images) %>
      </div>
      <div class="w-1/2 p-4">
        <div class="text-3xl my-4">
          <%= @product.name %>
          <%= link_to products_path("brand_ids[]" => @product.brand.id) do %>
            <div class="text-xl">
              <%= @product.brand.name %>
            </div>  
          <% end %>
          
        </div>
        <div>
        
          <%= link_to product_reviews_path(@product), class: "flex" do %>
            <div class="h-6 aspect-[5]">
              <%= render component("icons/star", percent: @product.average_rate * 100) %>
            </div>
          <% end %>
          <div>
            <%= pluralize @product.review_count, "Review" %>
          </div>
        </div>
        <div class="my-4">
          <div>
            seller: <%= @product.seller.username ? @product.seller.username : "example seller name"%>
          </div>
          <div>
            color: <%= @product.color %>
          </div>
        </div>
        <div class="my-4">
          <% if @product.campaign_id %>
            <div class="text-2xl text-first-500 font-bold  mt-2">
              <%= number_to_currency(@product.discount_price, :unit => "$") %>
            </div>
            <div class="flex  mb-2">
              <div class="text-xs line-through">
                <%= number_to_currency(@product.price, :unit => "$") %>
              </div>
              <span class="ml-2 text-xs font-bold">%<%= @product.discount %> </span>
            </div>
          
          <% else %>
          
            <div class="text-2xl font-bold mt-2">
              <%= number_to_currency(@product.price, :unit => "$") %>
            </div>
          <% end %>
        </div>
        <%= button_to "Add to Cart", order_items_path(order_item: {product_id: @product.id, quantity: 1}), class: "btn-first p-2 w-full font-bold" %>
        
      </div>
      
    </div>
    
    <%= render component("products/show/tabs", product: @product) %>
  </div>

  
  <% unless @products_from_category.empty? %>
    <div class=" mt-16">
      <div class="mx-8">
        From <%= @product.category.name %>
      </div>
      <%= render component("shared/carousel") do %>
        <%= render components("products/product", @products_from_category) %>
      <% end %>
    </div>
  <% end %>
<% end %>